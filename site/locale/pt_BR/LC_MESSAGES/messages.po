#: site/content/best.py:1
msgid "CRM plumbing for smaller teams"
msgstr "CRM para encanamento de equipes menores"

#: site/content/alternatives.py:1 site/content/best.py:1
#, python-brace-format
msgid "From {price}/user/mo"
msgstr "A partir de {price}/usuário/mês"

#: site/content/best.py:1
msgid "A bot records the call; stored in Fireflies' cloud"
msgstr "Um bot grava a chamada; armazenado na nuvem do Fireflies"

#: site/content/best.py:1
msgid ""
"Records, transcribes, scores and pushes to the CRM for a fraction of "
"Gong. A bot joins every call."
msgstr ""
"Registra, transcreve, pontua e envia para o CRM por uma fração do Gong. "
"Um bot se junta a cada chamada."

#: site/content/best.py:1
msgid "free call notes that fill in CRM fields"
msgstr "notas de chamada gratuitas que preenchem os campos do CRM"

#: site/content/best.py:1
msgid ""
"If you're a rep who just wants great call notes for free, get Fathom. The"
" bot is visible; some buyers don't care, some go quiet."
msgstr ""
"Se você é um representante que só quer ótimas notas de chamada "
"gratuitamente, use o Fathom. O bot é visível; alguns compradores não se "
