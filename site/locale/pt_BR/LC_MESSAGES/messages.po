msgstr "30 dias"

#: site/articles/blog__granola-pricing.html:29
msgid ""
"AI meeting notes, AI chat within and across meetings, shared folders, "
"templates, multi-language support, opt out of model training"
msgstr ""
"Notas de reunião com IA, chat com IA dentro e entre as reuniões, pastas "
"compartilhadas, modelos, suporte multilíngue, opção de não participar do "
"treinamento do modelo"

#: site/articles/blog__granola-pricing.html:30
#: site/articles/blog__granola-pricing.html:50
#: site/articles/blog__otter-pricing.html:32
msgid "Business"
msgstr "Empresarial"

