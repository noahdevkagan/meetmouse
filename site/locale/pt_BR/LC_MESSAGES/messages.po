#: site/content/best.py:1
msgid "a searchable archive of every meeting"
msgstr "Um arquivo de pesquisa de todas as reuniões"

#: site/content/best.py:1
#, python-brace-format
msgid "Free 300 min/mo; Pro {price}/mo"
msgstr "Grátis 300 min/mês; Pro {price}/mês"

