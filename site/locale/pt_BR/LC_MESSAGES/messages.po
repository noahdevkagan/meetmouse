msgstr "Preço"

#: site/articles/blog__granola-pricing.html:28
msgid "Meeting history"
msgstr "Histórico de reuniões"

#: site/articles/blog__granola-pricing.html:29
#: site/articles/blog__otter-pricing.html:30
msgid "Basic"
msgstr "Básico"

#: site/articles/blog__granola-pricing.html:29
